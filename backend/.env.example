NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://ENGORA_DB_USER:URL_ENCODED_PASSWORD@ENGORA_CLUSTER.mongodb.net/engora?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS

# Enable only for the first controlled admin creation, then set it back to false.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_NAME=Engora System Admin
ADMIN_BOOTSTRAP_EMAIL=admin@CLIENT_DOMAIN
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_TEMPORARY_PASSWORD

OPENAI_API_KEY=REPLACE_WITH_CLIENT_OPENAI_PROJECT_KEY
USE_OPENAI=true
OPENAI_MODEL=gpt-5.4-mini
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_CHAT_MAX_OUTPUT_TOKENS=120
OPENAI_MAX_OUTPUT_TOKENS=550
OPENAI_CHAT_TIMEOUT_MS=12000
OPENAI_EVALUATION_TIMEOUT_MS=9000

OPENAI_REALTIME_ENABLED=true
OPENAI_REALTIME_SCOPE=all
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
# Keep this empty so Engora can apply the voice mapping for each character.
OPENAI_REALTIME_FORCE_VOICE=
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=320
OPENAI_REALTIME_SESSION_TIMEOUT_MS=10000

TTS_CACHE_TTL_HOURS=24
CORS_ORIGIN=https://dashboard.CLIENT_DOMAIN,https://CLIENT_PROJECT.vercel.app
SAFETY_MAX_STUDENT_RESPONSES=30
FEATURE_MODULES_ENABLED=false
FEATURE_QR_ENABLED=false
