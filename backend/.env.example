NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/intercultural_ai
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_NAME=System Admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-temporary-password
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
USE_OPENAI=true
TTS_CACHE_TTL_HOURS=24
CORS_ORIGIN=https://your-dashboard.vercel.app
FEATURE_MODULES_ENABLED=false
FEATURE_QR_ENABLED=false
