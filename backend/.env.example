# Connection URI to MongoDB (Atlas or Local)
# Example: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb://localhost:27017/intercultural_ai

# Secret key for JWT Token Signature
JWT_SECRET=your_very_secure_random_string_here

# OpenAI configuration (optional, if using AI evaluation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
USE_OPENAI=true

# Port configuration
PORT=3000
